# Groq API Key for LLM
GROQ_API_KEY=your_groq_api_key_here

# Google (embeddings) and Pinecone (vector store) for the knowledge base
GOOGLE_API_KEY=your_google_api_key_here
PINECONE_API_KEY=your_pinecone_api_key_here
INDEX_NAME=your_pinecone_index_name

# Postgres connection string for business data and LangGraph checkpoints
DATABASE_URL=postgresql://user:password@localhost:5432/voice_agent

# Speech to text
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Text to speech
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Simli talking avatar (optional - the app runs voice-only without these)
SIMLI_API_KEY=your_simli_api_key_here
SIMLI_FACE_ID=your_simli_face_id_here

# JWT Authentication
JWT_SECRET_KEY=your_super_secret_jwt_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LangSmith tracing (optional - tracing stays off without an API key)
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=voice-agent
# Set to false to keep the key configured but stop sending traces
LANGSMITH_TRACING=true

