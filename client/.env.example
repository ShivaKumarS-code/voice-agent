# Base URL of the FastAPI server. The websocket URL is derived from this, so
# http:// becomes ws:// and https:// becomes wss:// automatically.
# Defaults to http://localhost:8000 when unset.
VITE_API_URL=http://localhost:8000

# Idle avatar clip that loops on the stage before the live avatar connects.
# Defaults to /avatar-idle.mp4 from public/. Re-export this from Simli if
# SIMLI_FACE_ID changes, or the loop and the live avatar are different people.
VITE_IDLE_VIDEO_URL=/avatar-idle.mp4
